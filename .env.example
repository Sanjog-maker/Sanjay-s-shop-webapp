# Server-side settings
# Optional: omit to use deterministic fallbacks for AI assistant and voice parsing.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Firebase web-app settings (VITE_ variables are exposed in browser builds).
# Use your own Firebase project and restrict its API key in Google Cloud.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIRESTORE_DATABASE_ID=""
